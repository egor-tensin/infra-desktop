[connection]
id={{ item.name }}
uuid={{ item.uuid }}
type=vpn
autoconnect=false

[vpn]
authtype=password
autoconnect-flags=0
certsigs-flags=0
cookie-flags=2
disable_udp=no
enable_csd_trojan=no
gateway={{ item.endpoint }}
gateway-flags=2
gwcert-flags=2
lasthost-flags=0
pem_passphrase_fsid=no
prevent_invalid_cert=no
protocol=anyconnect
resolve-flags=2
stoken_source=disabled
xmlconfig-flags=2
service-type=org.freedesktop.NetworkManager.openconnect

[vpn-secrets]
autoconnect=yes
form:main:username={{ vpn_username }}
lasthost={{ item.endpoint }}
save_passwords=no

[ipv4]
method=auto

[ipv6]
addr-gen-mode=stable-privacy
method=auto

[proxy]
