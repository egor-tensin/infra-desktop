udiskie > /dev/null 2>&1 &

kanshi > /dev/null 2>&1 &

swaybg -c '#334455' > /dev/null 2>&1 &

swayidle -w \
    timeout 300 'wlopm --off \*' \
    resume 'wlopm --on \*' \
    > /dev/null 2>&1 &

# mako (the notification service) has a preset-enabled user service, so I don't
