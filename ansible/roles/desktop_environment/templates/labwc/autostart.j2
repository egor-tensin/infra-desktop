{{ ansible_managed | comment }}

# udiskie doesn't seem to respect the "flat" menu option on Wayland, at least:
# https://github.com/coldfix/udiskie/issues/270
# The --no-menu-checkbox-workaround thing is just in case.
udiskie \
    --no-menu-checkbox-workaround \
    --no-menu-update-workaround \
    > /dev/null 2>&1 &

kanshi > /dev/null 2>&1 &

swaybg -c '#334455' > /dev/null 2>&1 &

swayidle -w \
    timeout 180 'wlopm --off \*' \
    resume 'wlopm --on \*' \
{% if not power_management_is_server %}
    timeout 295 "notify-send 'Going to suspend'" \
    timeout 300 'systemctl suspend' \
{% endif %}
    > /dev/null 2>&1 &

# mako (the notification service) has a preset-enabled user service, so I don't
# think it needs to be run here:
#mako > /dev/null 2>&1 &

nm-applet > /dev/null 2>&1 &
blueman-applet > /dev/null 2>&1 &

xfce4-panel > /dev/null 2>&1 &

# From https://wiki.archlinux.org/title/Labwc#Integration_with_systemd
systemctl -q --no-block --user start labwc-session.target
